---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { perfil } from '../data/perfil';
import '../styles/global.css';

interface Props {
	titulo: string;
	descripcion?: string;
}

const { titulo, descripcion = perfil.intro } = Astro.props;

const tituloCompleto = titulo === perfil.nombre ? titulo : `${titulo} — ${perfil.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{tituloCompleto}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />
		<link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={canonica} />
		<meta name="twitter:card" content="summary" />
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
