---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { perfil } from '../data/perfil';
import '../styles/global.css';

interface Props {
	titulo: string;
	descripcion?: string;
}

const { titulo, descripcion = perfil.intro } = Astro.props;

const tituloCompleto = titulo === perfil.nombre ? titulo : `${titulo} — ${perfil.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{tituloCompleto}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />
		{/* SVG: fondo transparente y color que sigue al tema del navegador */}
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
		/>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={canonica} />
		<meta name="twitter:card" content="summary" />
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
