---
import { perfil } from '../data/perfil';

const anio = new Date().getFullYear();

// Enlaces de contacto como texto, sin botones: el pie no debe competir
// con el contenido de la página.
const redes = [
	{ href: perfil.github, texto: 'GitHub', externo: true },
	{ href: perfil.linkedin, texto: 'LinkedIn', externo: true },
	{ href: perfil.email ? `mailto:${perfil.email}` : '', texto: 'Email', externo: false },
].filter((red) => red.href !== '');
---

<footer>
	<div>
		<p>© {anio} {perfil.nombre}</p>
		<ul>
			{
				redes.map((red) => (
					<li>
						<a
							href={red.href}
							rel={red.externo ? 'noopener noreferrer' : undefined}
							target={red.externo ? '_blank' : undefined}
						>
							{red.texto}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	div {
		max-width: var(--ancho);
		margin: 0 auto;
		padding: 1.4rem 1.5rem 2.5rem;
		border-top: 1px solid var(--linea);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}

	p {
		margin: 0;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 500;
		color: var(--suave);
	}

	ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		margin: 0;
		padding: 0;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 600;
	}

	a:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}
</style>
