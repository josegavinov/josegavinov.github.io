---
import type { CollectionEntry } from 'astro:content';
import { ruta } from '../utils/rutas';

interface Props {
	proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { titulo, descripcion, problema, tecnologias, repo, demo, privado, contexto, rol, borrador } =
	proyecto.data;

// La cita del problema es lo que lleva el peso visual de la tarjeta.
const cita = problema ?? descripcion;

const rotulos = {
	profesional: 'Proyecto profesional',
	academico: 'Proyecto académico',
	personal: 'Proyecto personal',
} as const;
const rotulo = borrador ? 'Plantilla' : rotulos[contexto];
---

<article>
	<p class="tipo">{rotulo}</p>

	<blockquote>«{cita}»</blockquote>

	<h3><a href={ruta(`/proyectos/${proyecto.id}`)}>{titulo}</a></h3>

	<p class="stack">
		{tecnologias.map((tec) => <b>{tec}</b>)}
	</p>

	{rol && <p class="rol">Mi parte: {rol}</p>}

	<p class="enlaces">
		<a href={ruta(`/proyectos/${proyecto.id}`)}>Ver detalle ↗</a>
		{repo && <a href={repo} rel="noopener noreferrer" target="_blank">Código ↗</a>}
		{privado && !repo && <span class="cerrado">Repositorio privado</span>}
		{demo && <a href={demo} rel="noopener noreferrer" target="_blank">Demo ↗</a>}
	</p>
</article>

<style>
	article {
		background: var(--panel);
		border: 1px solid var(--linea);
		border-radius: var(--radio);
		padding: 1.6rem 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		transition: transform 260ms cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 260ms ease;
	}

	article:hover {
		transform: translateY(-4px);
		box-shadow: 0 18px 32px -22px rgba(14, 16, 19, 0.5);
	}

	.tipo {
		margin: 0;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-etiqueta);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--acento);
	}

	blockquote {
		margin: 0;
		font-size: var(--t-cita);
		line-height: 1.35;
		letter-spacing: -0.012em;
	}

	h3 {
		margin: 0;
		font-size: var(--t-titulo);
		font-weight: 700;
	}

	.stack {
		margin: 0;
	}

	.rol {
		margin: 0;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 500;
		color: var(--suave);
	}

	.cerrado {
		font-weight: 500;
		color: var(--suave);
	}

	.enlaces {
		display: flex;
		flex-wrap: wrap;
		gap: 1.4rem;
		margin: auto 0 0;
		padding-top: 0.6rem;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 600;
	}

	.enlaces a:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}
</style>
