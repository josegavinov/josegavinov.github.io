---
import { getCollection } from 'astro:content';
import { ruta } from '../utils/rutas';
import { perfil } from '../data/perfil';

const total = (await getCollection('proyectos')).filter(
	({ data }) => import.meta.env.DEV || !data.borrador,
).length;

const actual = Astro.url.pathname.replace(/\/$/, '');

const enlaces = [
	{ href: ruta('/proyectos'), texto: 'Proyectos', cuenta: total },
	{ href: ruta('/sobre-mi'), texto: 'Sobre mí' },
];

const esActivo = (href: string) => href.replace(/\/$/, '') === actual;
---

<header>
	<nav aria-label="Navegación principal">
		<a class="marca" href={ruta('/')} aria-current={actual === '' ? 'page' : undefined}>
			{perfil.nombrePila} {perfil.apellido}
		</a>

		{
			perfil.disponibilidad && (
				<p class="disponible">
					<span aria-hidden="true" />
					{perfil.disponibilidad}
				</p>
			)
		}

		<ul>
			{
				enlaces.map((enlace) => (
					<li>
						<a href={enlace.href} aria-current={esActivo(enlace.href) ? 'page' : undefined}>
							{enlace.texto}
							{enlace.cuenta !== undefined && <sup>[{enlace.cuenta}]</sup>}
						</a>
					</li>
				))
			}
		</ul>

		<a class="boton" href={`mailto:${perfil.email}`}>Hablemos ↗</a>
	</nav>
</header>

<style>
	nav {
		max-width: var(--ancho);
		margin: 0 auto;
		padding: 1.5rem 1.5rem 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
	}

	.marca {
		font-family: 'Archivo', sans-serif;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.disponible {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 600;
		background: var(--panel);
		border: 1px solid var(--linea);
		border-radius: 99px;
		padding: 0.5rem 1.1rem;
	}

	.disponible span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--verde);
		flex: none;
	}

	ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 1.6rem;
		margin: 0;
		padding: 0;
		margin-left: auto;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 600;
	}

	sup {
		color: var(--suave);
		font-size: 0.7em;
		margin-left: 0.15em;
	}

	ul a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 6px;
	}

	/* En móvil se apila: la insignia y el CTA no caben en fila con los enlaces */
	@media (max-width: 700px) {
		nav {
			flex-direction: column;
			align-items: stretch;
			gap: 1rem;
		}

		.disponible {
			align-self: flex-start;
			max-width: 100%;
		}

		ul {
			margin-left: 0;
			gap: 1.4rem;
		}

		.boton {
			text-align: center;
		}
	}
</style>
