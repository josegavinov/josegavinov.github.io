---
import Base from '../layouts/Base.astro';
import { perfil } from '../data/perfil';

const contacto = [
	{ campo: 'GitHub', href: perfil.github, texto: 'josegavinov', externo: true },
	{ campo: 'LinkedIn', href: perfil.linkedin, texto: 'gaviñojose', externo: true },
	{
		campo: 'Email',
		href: perfil.email ? `mailto:${perfil.email}` : '',
		texto: perfil.email,
		externo: false,
	},
].filter((via) => via.href !== '');
---

<Base titulo="Sobre mí" descripcion={perfil.intro}>
	<p class="antetitulo">Sobre mí</p>
	<h1>Construyo backend que se puede mantener.</h1>

	<div class="columnas">
		<div class="prosa">
			<p>
				Hola, soy <strong>{perfil.nombre}</strong>. {perfil.titulo}
			</p>

			<p>{perfil.intro}</p>

			<h2>Mi enfoque</h2>
			<p>
				Me interesa aprender los patrones de diseño, comprender el flujo de datos entre el
				frontend y el backend, y escribir código mantenible aplicando buenas prácticas como
				SOLID y Clean Code.
			</p>
			<p>
				Además me interesa ser parte de proyectos con alto flujo de usuarios y formar parte 
				en equipos donde pueda aprender como se executa el manejo de desarrollo a producción, idear nuevas 
				funcionalidades y como las ideas son hechas realidad. Ser parte de este proceso me llama mucho la atención. 
			</p>
		</div>

		<aside>
			<dl class="ficha">
				{
					perfil.ficha.map((linea) => (
						<div>
							<dt>{linea.campo}</dt>
							<dd>{linea.valor}</dd>
						</div>
					))
				}
			</dl>

			<h2 class="antetitulo">Contacto</h2>
			<dl class="ficha">
				{
					contacto.map((via) => (
						<div>
							<dt>{via.campo}</dt>
							<dd>
								<a
									href={via.href}
									rel={via.externo ? 'noopener noreferrer' : undefined}
									target={via.externo ? '_blank' : undefined}
								>
									{via.texto}
								</a>
							</dd>
						</div>
					))
				}
			</dl>
		</aside>
	</div>

	<section class="tecnologias">
		<h2>Tecnologías</h2>
		<p class="nota">Todo lo de aquí está usado en algún proyecto del portafolio.</p>

		<div class="areas">
			{
				perfil.stack.map((grupo) => (
					<div class="area">
						<h3>{grupo.area}</h3>
						<p class="stack">
							{grupo.items.map((item) => (
								<b>{item}</b>
							))}
						</p>
					</div>
				))
			}
		</div>
	</section>
</Base>

<style>
	h1 {
		font-size: var(--t-rotulo);
		font-weight: 900;
		max-width: 18ch;
		margin-bottom: 2.5rem;
	}

	.columnas {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 3.5rem;
		align-items: start;
	}

	.prosa {
		max-width: 62ch;
	}

	.prosa h2 {
		font-size: var(--t-titulo);
		font-weight: 700;
		margin-top: 2.2rem;
	}

	.ficha {
		margin: 0 0 2.2rem;
		border-top: 2px solid var(--tinta);
		padding-top: 0.9rem;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
	}

	.ficha div {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.2rem 1rem;
		padding: 0.32rem 0;
	}

	.ficha dt {
		color: var(--suave);
		font-weight: 600;
	}

	.ficha dd {
		margin: 0;
		font-weight: 600;
		text-align: right;
	}

	.ficha a:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	/* --- Tecnologías, a ancho completo --- */
	.tecnologias {
		margin-top: 4rem;
		border-top: 2px solid var(--tinta);
		padding-top: 1.5rem;
	}

	.tecnologias h2 {
		font-size: var(--t-titulo);
		font-weight: 800;
		margin: 0 0 0.3rem;
	}

	.nota {
		margin: 0 0 2rem;
		font-size: var(--t-menor);
		color: var(--suave);
	}

	.areas {
		display: grid;
		/* Dos columnas anchas: con tres, las listas largas parten en dos
		   líneas y el separador queda colgando al final. */
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
		gap: 1.9rem 3rem;
	}

	.area h3 {
		margin: 0 0 0.45rem;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-etiqueta);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--suave);
	}

	.area .stack {
		line-height: 1.7;
	}

	@media (max-width: 900px) {
		.columnas {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
