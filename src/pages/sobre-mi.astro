---
import Base from '../layouts/Base.astro';
import { perfil } from '../data/perfil';

const contacto = [
	{ campo: 'GitHub', href: perfil.github, texto: 'josegavinov', externo: true },
	{ campo: 'LinkedIn', href: perfil.linkedin, texto: 'gaviñojose', externo: true },
	{
		campo: 'Email',
		href: perfil.email ? `mailto:${perfil.email}` : '',
		texto: perfil.email,
		externo: false,
	},
].filter((via) => via.href !== '');
---

<Base titulo="Sobre mí" descripcion={perfil.intro}>
	<p class="antetitulo">Sobre mí</p>
	<h1>Construyo backend que se puede mantener.</h1>

	<div class="columnas">
		<div class="prosa">
			<p>
				Hola, soy <strong>{perfil.nombre}</strong>. {perfil.titulo}, y vivo en {
					perfil.ficha.find((f) => f.campo === 'Ubicación')?.valor
				}.
			</p>

			<p>{perfil.intro}</p>

			<h2>Mi enfoque</h2>
			<p>
				Me interesa aprender los patrones de diseño, comprender el flujo de datos entre el
				frontend y el backend, y escribir código mantenible aplicando buenas prácticas como
				SOLID y Clean Code.
			</p>
		</div>

		<aside>
			<dl class="ficha">
				{
					perfil.ficha.map((linea) => (
						<div>
							<dt>{linea.campo}</dt>
							<dd>{linea.valor}</dd>
						</div>
					))
				}
			</dl>

			<h2 class="antetitulo">Tecnologías</h2>
			<p class="stack">
				{perfil.habilidades.map((h) => <b class={h.fuerte ? 'fuerte' : undefined}>{h.nombre}</b>)}
			</p>

			<h2 class="antetitulo">Contacto</h2>
			<dl class="ficha">
				{
					contacto.map((via) => (
						<div>
							<dt>{via.campo}</dt>
							<dd>
								<a
									href={via.href}
									rel={via.externo ? 'noopener noreferrer' : undefined}
									target={via.externo ? '_blank' : undefined}
								>
									{via.texto}
								</a>
							</dd>
						</div>
					))
				}
			</dl>
		</aside>
	</div>
</Base>

<style>
	h1 {
		font-size: var(--t-rotulo);
		font-weight: 900;
		max-width: 18ch;
		margin-bottom: 2.5rem;
	}

	.columnas {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 3.5rem;
		align-items: start;
	}

	.prosa {
		max-width: 62ch;
	}

	.prosa h2 {
		font-size: var(--t-titulo);
		font-weight: 700;
		margin-top: 2.2rem;
	}

	.ficha {
		margin: 0 0 2.2rem;
		border-top: 2px solid var(--tinta);
		padding-top: 0.9rem;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
	}

	.ficha div {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.2rem 1rem;
		padding: 0.32rem 0;
	}

	.ficha dt {
		color: var(--suave);
		font-weight: 600;
	}

	.ficha dd {
		margin: 0;
		font-weight: 600;
		text-align: right;
	}

	.ficha a:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	aside .stack {
		margin-bottom: 2.2rem;
	}

	@media (max-width: 900px) {
		.columnas {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
