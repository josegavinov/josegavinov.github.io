---
import Base from '../../layouts/Base.astro';
import TarjetaProyecto from '../../components/TarjetaProyecto.astro';
import { obtenerProyectos } from '../../utils/proyectos';
import { perfil } from '../../data/perfil';

const proyectos = await obtenerProyectos();

const cuenta = (clave: string) =>
	clave === 'todos' ? proyectos.length : proyectos.filter((p) => p.data.contexto === clave).length;

// Solo se ofrecen los filtros que tienen algo detrás.
const filtros = [
	{ clave: 'todos', texto: 'Todos' },
	{ clave: 'profesional', texto: 'Profesionales' },
	{ clave: 'academico', texto: 'Académicos' },
	{ clave: 'personal', texto: 'Personales' },
].filter((f) => cuenta(f.clave) > 0);
---

<Base
	titulo="Proyectos"
	descripcion="Proyectos de software que he construido: qué resuelven, cómo están hechos y dónde ver el código."
>
	<header class="cabecera">
		<p class="agua" aria-hidden="true">PROYECTOS</p>
		<h1><span>/</span>LO QUE HE CONSTRUIDO</h1>
	</header>

	<div class="barra">
		<div class="filtros" role="group" aria-label="Filtrar proyectos por tipo">
			{
				filtros.map((f) => (
					<button type="button" data-filtro={f.clave} aria-pressed={f.clave === 'todos'}>
						{f.texto}
					</button>
				))
			}
		</div>
		<a class="ver" href={perfil.github} rel="noopener noreferrer" target="_blank">Ver en GitHub ↗</a>
	</div>

	<div class="rejilla">
		{proyectos.map((proyecto) => <TarjetaProyecto proyecto={proyecto} />)}
	</div>

	<p class="vacio" hidden>No hay proyectos de este tipo todavía.</p>
</Base>

<script>
	const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
	const tarjetas = document.querySelectorAll<HTMLElement>('.rejilla > [data-contexto]');
	const vacio = document.querySelector<HTMLElement>('.vacio');

	function aplicar(clave: string) {
		let visibles = 0;
		tarjetas.forEach((t) => {
			const mostrar = clave === 'todos' || t.dataset.contexto === clave;
			t.hidden = !mostrar;
			if (mostrar) visibles++;
		});
		botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === clave)));
		if (vacio) vacio.hidden = visibles > 0;
	}

	botones.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.filtro ?? 'todos')));
</script>

<style>
	.cabecera {
		position: relative;
		text-align: center;
		padding-top: 5.5rem;
		margin-bottom: 2.5rem;
		/* La marca de agua es decorativa: que nunca provoque scroll lateral */
		overflow: hidden;
	}

	.agua {
		position: absolute;
		inset-inline: 0;
		top: 0;
		margin: 0;
		font-family: 'Archivo', sans-serif;
		font-size: clamp(1.75rem, 12vw, 8rem);
		font-weight: 900;
		letter-spacing: -0.03em;
		line-height: 1;
		color: rgba(14, 16, 19, 0.05);
		user-select: none;
		pointer-events: none;
	}

	h1 {
		position: relative;
		margin: 0;
		font-size: var(--t-rotulo);
		font-weight: 900;
		letter-spacing: -0.03em;
	}

	h1 span {
		color: var(--acento);
	}

	.barra {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		margin-bottom: 2.25rem;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 600;
	}

	.filtros {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
	}

	button {
		font: inherit;
		background: none;
		border: 0;
		padding: 0;
		color: var(--suave);
		cursor: pointer;
		transition: color 200ms ease;
	}

	button:hover {
		color: var(--tinta);
	}

	/* El activo se marca solo con tinta: sin subrayado, para no competir
	   con el que el menú usa para la página actual. */
	button[aria-pressed='true'] {
		color: var(--tinta);
	}

	/* Pastilla a la derecha, como el "View All Work" de la referencia */
	.ver {
		background: var(--panel);
		border: 1px solid var(--linea);
		border-radius: 99px;
		padding: 0.55rem 1.25rem;
		transition: border-color 200ms ease, transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
	}

	.ver:hover {
		color: var(--tinta);
		border-color: var(--tinta);
		transform: translateY(-1px);
	}

	.rejilla {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
		align-items: stretch;
	}

	.vacio {
		margin: 0;
		padding: 3rem 0;
		text-align: center;
		color: var(--suave);
	}
</style>
