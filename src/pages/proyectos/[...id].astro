---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { ruta } from '../../utils/rutas';
import { obtenerProyectos } from '../../utils/proyectos';

export const getStaticPaths = (async () => {
	const proyectos = await obtenerProyectos();
	return proyectos.map((proyecto) => ({
		params: { id: proyecto.id },
		props: { proyecto },
	}));
}) satisfies GetStaticPaths;

const { proyecto } = Astro.props;
const { titulo, descripcion, problema, tecnologias, repo, demo, borrador } = proyecto.data;
const { Content } = await render(proyecto);
---

<Base titulo={titulo} descripcion={descripcion}>
	<p class="volver"><a href={ruta('/proyectos')}>← Proyectos</a></p>

	<header class="cabecera">
		<h1>{titulo}</h1>
		{problema && <blockquote>«{problema}»</blockquote>}
		<p class="resumen">{descripcion}</p>
	</header>

	{
		borrador && (
			<p class="aviso">
				Este proyecto todavía es una plantilla: reemplaza su contenido en
				<code>src/content/proyectos/{proyecto.id}.md</code>.
			</p>
		)
	}

	<dl class="datos">
		<div>
			<dt>Stack</dt>
			<dd>
				<span class="stack">{tecnologias.map((tec) => <b>{tec}</b>)}</span>
			</dd>
		</div>
		{
			(repo || demo) && (
				<div>
					<dt>Enlaces</dt>
					<dd class="enlaces">
						{repo && (
							<a href={repo} rel="noopener noreferrer" target="_blank">
								Código ↗
							</a>
						)}
						{demo && (
							<a href={demo} rel="noopener noreferrer" target="_blank">
								Demo ↗
							</a>
						)}
					</dd>
				</div>
			)
		}
	</dl>

	<article class="prosa">
		<Content />
	</article>
</Base>

<style>
	.volver {
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 600;
		margin-bottom: 2rem;
	}

	.cabecera {
		max-width: 42ch;
	}

	h1 {
		font-size: var(--t-rotulo);
		font-weight: 900;
		margin-bottom: 1.2rem;
	}

	blockquote {
		margin: 0 0 1rem;
		font-size: var(--t-cita);
		line-height: 1.35;
		letter-spacing: -0.012em;
	}

	.resumen {
		margin: 0;
		color: var(--suave);
	}

	.aviso {
		background: var(--panel);
		border: 1px solid var(--linea);
		border-left: 3px solid var(--acento);
		border-radius: 4px;
		padding: 0.85rem 1.1rem;
		font-size: var(--t-menor);
		margin-top: 2rem;
	}

	.datos {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 3.5rem;
		margin: 2.5rem 0 0;
		border-top: 1px solid var(--linea);
		padding-top: 1.2rem;
	}

	.datos dt {
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-etiqueta);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--suave);
		margin-bottom: 0.35rem;
	}

	.datos dd {
		margin: 0;
	}

	.enlaces {
		display: flex;
		flex-wrap: wrap;
		gap: 1.4rem;
		font-family: 'Archivo', sans-serif;
		font-size: var(--t-menor);
		font-weight: 600;
	}

	.enlaces a:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	/* Cuerpo en markdown: ancho de lectura cómodo */
	.prosa {
		max-width: 62ch;
		margin-top: 3rem;
		border-top: 1px solid var(--linea);
		padding-top: 2rem;
	}

	.prosa :global(h2) {
		font-size: var(--t-titulo);
		font-weight: 700;
		margin-top: 2.2rem;
	}

	.prosa :global(h2:first-child) {
		margin-top: 0;
	}

	.prosa :global(a) {
		color: var(--acento);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
