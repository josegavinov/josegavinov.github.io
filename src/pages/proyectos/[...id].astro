---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { ruta } from '../../utils/rutas';
import { obtenerProyectos } from '../../utils/proyectos';

export const getStaticPaths = (async () => {
	const proyectos = await obtenerProyectos();
	return proyectos.map((proyecto) => ({
		params: { id: proyecto.id },
		props: { proyecto },
	}));
}) satisfies GetStaticPaths;

const { proyecto } = Astro.props;
const { titulo, descripcion, tecnologias, repo, demo, borrador } = proyecto.data;
const { Content } = await render(proyecto);
---

<Base titulo={titulo} descripcion={descripcion}>
	<p class="volver"><a href={ruta('/proyectos')}>← Proyectos</a></p>

	<h1>{titulo}</h1>
	<p class="sutil">{descripcion}</p>

	{
		borrador && (
			<p class="aviso">
				Este proyecto todavía es una plantilla: reemplaza su contenido en
				<code>src/content/proyectos/{proyecto.id}.md</code>.
			</p>
		)
	}

	<ul class="etiquetas">
		{tecnologias.map((tec) => <li class="etiqueta">{tec}</li>)}
	</ul>

	{
		(repo || demo) && (
			<p class="enlaces">
				{repo && (
					<a href={repo} rel="noopener noreferrer" target="_blank">
						Ver código
					</a>
				)}
				{demo && (
					<a href={demo} rel="noopener noreferrer" target="_blank">
						Ver demo
					</a>
				)}
			</p>
		)
	}

	<article>
		<Content />
	</article>
</Base>

<style>
	.volver {
		font-weight: 600;
		margin-bottom: 1.5rem;
	}

	.aviso {
		background: var(--superficie);
		border: 1px solid #fbbf24;
		border-radius: var(--radio);
		padding: 0.85rem 1.1rem;
		font-size: 0.92rem;
	}

	.etiquetas {
		margin: 1.5rem 0;
	}

	.enlaces {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		font-weight: 600;
	}

	article {
		border-top: 1px solid var(--borde);
		margin-top: 2rem;
		padding-top: 1.5rem;
	}
</style>
